  "rondas": 0,
  "historial": [
    {
      "id": "0001",
      "texto": "No te falta tiempo. Te falta decirlo en voz alta.",
      "fecha": "2026-08-13",
      "saltado": true
    },
    {
      "id": "0002",
      "texto": "El insomnio es la casa donde viven las cosas que no dije.",
      "fecha": "2026-08-13",
      "numero": 1,
      "ig_post_id": "18113318119752823",
      "url": "https://raw.githubusercontent.com/mcurtefcc-ops/pomniii-writes/main/publicadas/2026-08-13_0002.jpg",
      "enlace": "https://www.instagram.com/p/Db_01T_GNf_/"
    },
    {
      "id": "0003",
      "texto": "Duermo con la luz encendida por si vuelven las ganas.",
      "fecha": "2026-08-14",
      "numero": 2,
      "ig_post_id": "17943735402276231",
      "url": "https://raw.githubusercontent.com/mcurtefcc-ops/pomniii-writes/main/publicadas/2026-08-14_0003.jpg",
      "enlace": "https://www.instagram.com/p/DcAursRIERa/"
    },
    {
      "id": "0004",
      "texto": "Si hoy solo has respirado, ya has hecho bastante. Te lo digo yo, que tampoco pude más.",
      "fecha": "2026-08-14",
      "saltado": true
    },
    {
      "id": "0005",
      "texto": "Te quedaste por miedo y lo llamaste amor.",
      "fecha": "2026-08-14",
      "saltado": true
    },
    {
      "id": "0006",
      "texto": "Hay puertas que solo abren por dentro. Llevaba la llave en el bolsillo.",
      "fecha": "2026-08-25",
      "numero": 3,
      "ig_post_id": "18491072626097341",
      "url": "https://raw.githubusercontent.com/mcurtefcc-ops/pomniii-writes/main/publicadas/2026-08-25_0006.jpg",
      "enlace": "https://www.instagram.com/p/DcdK-2yoBMt/"
    },
    {
      "id": "0007",
      "texto": "Te pienso a las tres de la mañana, que es cuando no tengo abogados.",
      "fecha": "2026-08-26",
      "numero": 4,
      "ig_post_id": "17909298948288761",
      "url": "https://raw.githubusercontent.com/mcurtefcc-ops/pomniii-writes/main/publicadas/2026-08-26_0007.jpg",
      "enlace": "https://www.instagram.com/p/Dcf2zrsIKu5/"
    },
    {
      "id": "0008",
      "texto": "Te dejo esto aquí por si mañana lo necesitas: sigues a tiempo.",
      "fecha": "2026-08-26",
      "saltado": true
    },
    {
      "id": "0009",
      "texto": "Nadie te está esperando. Por eso puedes ir donde quieras.",
      "fecha": "2026-08-27",
      "numero": 5,
      "ig_post_id": "18153485242502407",
      "url": "https://raw.githubusercontent.com/mcurtefcc-ops/pomniii-writes/main/publicadas/2026-08-27_0009.jpg",
      "enlace": "https://www.instagram.com/p/Dcidu09IFeh/"
    },
    {
      "id": "0010",
      "texto": "Me mudé de ciudad para no mudarme de mí. No funcionó, y fue lo mejor que hice.",
      "fecha": "2026-08-28",
      "saltado": true
    },
    {
      "id": "0011",
      "texto": "Lo peor no fue perderte. Fue lo bien que se me dio acostumbrarme.",
      "fecha": "2026-08-28",
      "numero": 6,
      "ig_post_id": "18097099421369597",
      "url": "https://raw.githubusercontent.com/mcurtefcc-ops/pomniii-writes/main/publicadas/2026-08-28_0011.jpg",
      "enlace": "https://www.instagram.com/p/Dck3QC7lhe6/"
    },
    {
      "id": "0012",
      "texto": "No te pido que estés bien. Te pido que no te vayas del todo.",
      "fecha": "2026-08-29",
      "numero": 7,
      "ig_post_id": "17874186480565696",
      "url": "https://raw.githubusercontent.com/mcurtefcc-ops/pomniii-writes/main/publicadas/2026-08-29_0012.jpg",
      "enlace": "https://www.instagram.com/p/DcnVVAXFtdh/"
    },
    {
      "id": "0013",
      "texto": "No estabas cansado. Estabas fingiendo.",
      "fecha": "2026-08-30",
      "saltado": true
    },
    {
      "id": "0014",
      "texto": "Guardo tu nombre\nen la parte del mapa\ndonde ya no voy.",
      "fecha": "2026-08-30",
      "numero": 8,
      "ig_post_id": "18133044565653513",
      "url": "https://raw.githubusercontent.com/mcurtefcc-ops/pomniii-writes/main/publicadas/2026-08-30_0014.jpg",
      "enlace": "https://www.instagram.com/p/DcqkJNqm5iC/"
    },
    {
      "id": "0015",
      "texto": "A las tres de la mañana\ntodos somos honestos\ny nadie está despierto\npara oírlo.",
      "fecha": "2026-08-31",
      "numero": 9,
      "ig_post_id": "18119918759481202",
      "url": "https://raw.githubusercontent.com/mcurtefcc-ops/pomniii-writes/main/publicadas/2026-08-31_0015.jpg",
      "enlace": "https://www.instagram.com/p/DcsZwuam-M5/"
    },
    {
      "id": "0016",
      "texto": "Sé que estás cansado. No hace falta que lo expliques, no hoy.",
      "fecha": "2026-08-31",
      "numero": 10,
      "ig_post_id": "18123335944864528",
      "url": "https://raw.githubusercontent.com/mcurtefcc-ops/pomniii-writes/main/publicadas/2026-08-31_0016.jpg",
      "enlace": "https://www.instagram.com/p/Dcs1GsRlvqm/"
    },
    {
      "id": "0017",
      "texto": "Lo que no eliges, se elige solo. Y elige mal.",
      "fecha": "2026-09-01",
      "numero": 11,
      "ig_post_id": "18350418532173092",
      "url": "https://raw.githubusercontent.com/mcurtefcc-ops/pomniii-writes/main/publicadas/2026-09-01_0017.jpg",
      "enlace": "https://www.instagram.com/p/DcwQM7plGEV/"
    },
    {
      "id": "0018",
      "texto": "Aprendí a leer los silencios y desde entonces leo menos libros.",
      "fecha": "2026-09-02",
      "numero": 12,
      "ig_post_id": "18099828629112415",
      "url": "https://raw.githubusercontent.com/mcurtefcc-ops/pomniii-writes/main/publicadas/2026-09-02_0018.jpg",
      "enlace": "https://www.instagram.com/p/DcyBx62FlmR/"
    },
    {
      "id": "0019",
      "texto": "Sigo poniendo dos tazas. La costumbre tarda más en irse que la gente.",
      "fecha": "2026-09-03",
      "numero": 13,
      "ig_post_id": "18381803995237503",
      "url": "https://raw.githubusercontent.com/mcurtefcc-ops/pomniii-writes/main/publicadas/2026-09-03_0019.jpg",
      "enlace": "https://www.instagram.com/p/Dc0EqBYER7m/"
    },
    {
      "id": "0020",
      "texto": "Si has llegado hasta aquí leyendo, es que aún te queda algo. Y con algo se empieza.",
      "fecha": "2026-09-04",
      "numero": 14,
      "ig_post_id": "18077159567354991",
      "url": "https://raw.githubusercontent.com/mcurtefcc-ops/pomniii-writes/main/publicadas/2026-09-04_0020.jpg",
      "enlace": "https://www.instagram.com/p/Dc2-MwvHM2C/"
    },
    {
      "id": "0021",
      "texto": "Dijiste que era complicado. Era que no querías.",
      "fecha": "2026-09-05",
      "saltado": true
    },
    {
      "id": "0022",
      "texto": "La memoria es un perro que solo obedece de noche.",
      "fecha": "2026-09-05",
      "numero": 15,
      "ig_post_id": "18373504468240251",
      "url": "https://raw.githubusercontent.com/mcurtefcc-ops/pomniii-writes/main/publicadas/2026-09-05_0022.jpg",
