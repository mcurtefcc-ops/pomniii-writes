# ============================================================
#  Copia este archivo como  .env  y rellena los valores.
#  El .env NO se sube nunca a ningun sitio (esta en .gitignore).
# ============================================================

# --- Instagram -----------------------------------------------
# Que modalidad de la API de Meta usas:
#   instagram = Instagram API con Instagram Login. El token se genera desde el
#               panel de la app, en "Genera identificadores de acceso". No hace
#               falta pagina de Facebook. Dura 60 dias y se renueva con:
#                   python -m src.cli renovar
#   facebook  = con Facebook Login y token de pagina. Requiere pagina vinculada
#               y el Explorador de la API Graph, pero el token no caduca.
IG_MODO=instagram

# Token de acceso. Es la credencial importante de este archivo.
IG_ACCESS_TOKEN=

# ID numerico de la cuenta (NO el @handle).
# En modo "instagram" puedes dejarlo VACIO: se deduce del token.
# En modo "facebook" es obligatorio.
IG_USER_ID=

# Version de la Graph API. Si al publicar recibes un error de version
# no soportada, sube el numero (v24.0, v25.0...) o bajalo (v21.0).
GRAPH_VERSION=v23.0

# --- Hosting de imagenes -------------------------------------
# Instagram exige una URL publica de la imagen: no acepta archivos locales.
# Clave gratuita de imgbb (30 segundos, sin tarjeta): https://api.imgbb.com/
IMGBB_API_KEY=

# --- Telegram (el canal de aprobacion) ------------------------
# Token que te da @BotFather al crear el bot. Ver README, paso 4.
TELEGRAM_TOKEN=

# Tu chat con el bot. Escribele algo al bot y luego ejecuta:
#   python -m src.cli chatid
TELEGRAM_CHAT_ID=
